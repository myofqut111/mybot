<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fishbot_bringup</name>
  <version>0.0.0</version>
  <description>Fishbot bringup: micro-ROS agent + URDF/TF + laser (docker/local)</description>
  <maintainer email="fishros@foxmail.com">fishros</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>fishbot_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>micro_ros_agent</exec_depend>
  <!-- laser_mode=local 时才需要这两个，docker 模式可忽略 -->
  <exec_depend>ros_serail2wifi</exec_depend>
  <exec_depend>ydlidar</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
