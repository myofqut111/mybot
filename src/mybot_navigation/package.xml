<?xml version="1.0"?>
<package format="3">
  <name>mybot_navigation</name>
  <version>0.1.0</version>
  <description>Nav2 navigation bringup for the ESP32 differential-drive mybot (EKF + AMCL + Nav2 + patrol).</description>
  <maintainer email="dev@example.com">Mybot Maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- launch 期 RewrittenYaml 来自 nav2_common -->
  <exec_depend>nav2_common</exec_depend>
  <!-- Nav2 各组件（可执行节点/生命周期） -->
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <!-- EKF 里程计融合（替代 Go2 的 FAST-LIO） -->
  <exec_depend>robot_localization</exec_depend>
  <!-- 一键建图：URDF/TF + slam_toolbox + rviz -->
  <exec_depend>mybot_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <!-- 巡检系统 -->
  <exec_depend>mybot_patrol_executor</exec_depend>
  <!-- 脚本依赖 -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
