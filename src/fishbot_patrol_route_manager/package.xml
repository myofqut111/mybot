<?xml version="1.0"?>
<package format="3">
  <name>fishbot_patrol_route_manager</name>
  <version>0.1.0</version>
  <description>Records AMCL poses and persistently manages fishbot patrol routes.</description>
  <maintainer email="dev@example.com">Fishbot Maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>fishbot_patrol_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
