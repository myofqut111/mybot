<?xml version="1.0"?>
<package format="3">
  <name>mybot_patrol_task_manager</name>
  <version>0.1.0</version>
  <description>Dispatches and tracks inspection tasks at mybot patrol points.</description>
  <maintainer email="dev@example.com">Mybot Maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>mybot_patrol_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
