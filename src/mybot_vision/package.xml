<?xml version="1.0"?>
<package format="3">
  <name>mybot_vision</name>
  <version>0.1.2</version>
  <description>ESP32 OV3660 WiFi camera streaming and YOLO object detection for mybot.</description>
  <maintainer email="dev@example.com">Mybot Maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>mybot_patrol_interfaces</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
