# 代码要在 Linux 上跑，仓库里一律存 LF。
# 不加这段的话，Windows 上 core.autocrlf=true 会把 .sh/.py 存成 CRLF，
# 到 Linux 上 shebang 变成 "#!/usr/bin/env python3\r" → bad interpreter，
# 报错信息还很不直观（只说找不到解释器）。
* text=auto eol=lf

*.py    text eol=lf
*.sh    text eol=lf
*.launch.py text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.xml   text eol=lf
*.msg   text eol=lf
*.srv   text eol=lf
*.action text eol=lf
*.md    text eol=lf
*.txt   text eol=lf

# 二进制：别做任何换行/编码转换
*.pt    binary
*.pth   binary
*.onnx  binary
*.engine binary
*.mnn   binary
*.bin   binary
*.png   binary
*.jpg   binary
*.pdf   binary
